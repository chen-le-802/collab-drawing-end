{
  "name": "collab-drawing-end",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend skeleton with TypeScript and pnpm.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/scripts/migrate.ts up",
    "migrate:status": "ts-node src/scripts/migrate.ts status",
    "migrate:baseline": "ts-node src/scripts/migrate.ts baseline",
    "preflight": "ts-node src/scripts/preflight.ts basic",
    "preflight:full": "ts-node src/scripts/preflight.ts full",
    "demo:conflict": "ts-node src/scripts/conflict-demo.ts",
    "demo:idempotency": "ts-node src/scripts/idempotency-demo.ts",
    "backup:once": "ts-node src/scripts/backup.ts once",
    "backup:daemon": "ts-node src/scripts/backup.ts daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot --bail=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.15.2",
    "redis": "^4.7.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.17",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.7.2",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
